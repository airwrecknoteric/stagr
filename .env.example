# Convex
PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk (JWT template must be named "convex")
# Enable Google + Apple Sign in with Apple in the Clerk dashboard (Apple is required for iOS when social login exists).
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
PUBLIC_CLERK_SIGN_IN_URL=/sign-in
PUBLIC_CLERK_SIGN_UP_URL=/sign-up
PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/app
PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/app/onboarding

# Mapbox
PUBLIC_MAPBOX_TOKEN=

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10

# Admin (comma-separated)
ADMIN_EMAILS=

# Optional: FCM server key for native push (Capacitor tokens)
FCM_SERVER_KEY=

# Capacitor live URL (production web app)
PUBLIC_APP_URL=http://localhost:5173
